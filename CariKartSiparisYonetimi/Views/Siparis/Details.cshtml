@model Siparis
@using System.Globalization
@{
    ViewData["Title"] = "Sipariş " + Model.SiparisNo;
    var tr = new CultureInfo("tr-TR");
}

<h1>Sipariş @Model.SiparisNo</h1>

<dl class="row">
    <dt class="col-sm-2">Sipariş No</dt>
    <dd class="col-sm-10">@Model.SiparisNo</dd>

    <dt class="col-sm-2">Sipariş Tarihi</dt>
    <dd class="col-sm-10">@Model.SiparisTarihi.ToString("dd.MM.yyyy")</dd>

    <dt class="col-sm-2">Cari</dt>
    <dd class="col-sm-10">@Model.CariKart?.CariKod - @Model.CariKart?.FirmaAdi</dd>

    <dt class="col-sm-2">Açıklama</dt>
    <dd class="col-sm-10">@Model.Aciklama</dd>
</dl>

<h2 class="h4">Sipariş Satırları</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Ürün / Hizmet Adı</th>
            <th class="text-end">Miktar</th>
            <th class="text-end">Birim Fiyat</th>
            <th class="text-end">Tutar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var detay in Model.Detaylar)
        {
            <tr>
                <td>@detay.UrunAdi</td>
                <td class="text-end">@detay.Miktar.ToString("0.##", tr)</td>
                <td class="text-end">@detay.BirimFiyat.ToString("N2", tr) TL</td>
                <td class="text-end">@detay.Tutar.ToString("N2", tr) TL</td>
            </tr>
        }
    </tbody>
    <tfoot>
        <tr>
            <th colspan="3" class="text-end">Sipariş Toplamı</th>
            <th class="text-end">@Model.ToplamTutar.ToString("N2", tr) TL</th>
        </tr>
    </tfoot>
</table>

<a asp-action="Create" class="btn btn-primary">Yeni Sipariş</a>
<a asp-action="List" class="btn btn-secondary">Listeye Dön</a>