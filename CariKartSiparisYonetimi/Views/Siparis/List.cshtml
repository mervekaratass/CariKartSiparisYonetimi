@model List<Siparis>
@using System.Globalization
@{
    ViewData["Title"] = "Siparişler";
    var tr = new CultureInfo("tr-TR");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Siparişler</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni Sipariş</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Henüz sipariş yok.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Sipariş No</th>
                <th>Tarih</th>
                <th>Cari Adı</th>
                <th class="text-end">Toplam Tutar</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var siparis in Model)
            {
                <tr>
                    <td>@siparis.SiparisNo</td>
                    <td>@siparis.SiparisTarihi.ToString("dd.MM.yyyy")</td>
                    <td>@siparis.CariKart?.FirmaAdi</td>
                    <td class="text-end">@siparis.ToplamTutar.ToString("N2", tr) TL</td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@siparis.Id" class="btn btn-sm btn-outline-primary">Detay</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}