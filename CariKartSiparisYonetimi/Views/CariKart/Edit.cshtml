@model CariKart
@{
    ViewData["Title"] = "Cari Kart Düzenle";
}

<h1>Cari Kart Düzenle</h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <partial name="_Form" model="Model" />

    <button type="submit" class="btn btn-primary">Güncelle</button>
    <a asp-action="List" class="btn btn-secondary">Vazgeç</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}