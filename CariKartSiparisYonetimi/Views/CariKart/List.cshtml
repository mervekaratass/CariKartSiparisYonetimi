@model List<CariKart>
@{
    ViewData["Title"] = "Cari Kartlar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Cari Kartlar</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni Cari Kart</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Henüz cari kart yok.</div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Cari Kodu</th>
                <th>Firma Adı</th>
                <th>Vergi Numarası</th>
                <th>Telefon</th>
                <th>E-posta</th>
                <th>Durum</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cari in Model)
            {
                <tr>
                    <td>@cari.CariKod</td>
                    <td>@cari.FirmaAdi</td>
                    <td>@cari.VergiNo</td>
                    <td>@cari.Telefon</td>
                    <td>@cari.EPosta</td>
                    <td>
                        @if (cari.Durum)
                        {
                            <span class="badge bg-success">Aktif</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Pasif</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@cari.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>        
                    <form asp-action="ToggleStatus" asp-route-id="@cari.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                            @(cari.Durum ? "Pasife Al" : "Aktif Et")
                        </button>
                    </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}